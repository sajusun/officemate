{
  "name": "officemate-edge",
  "version": "1.0.0",
  "description": "The Productivity Copilot for Microsoft 365, Outlook Web, Teams and Project Workspace Tab Stash",
  "type": "module",
  "scripts": {
    "dev": "node init && node scripts/build.js --watch",
    "build": "node init && tsc --noEmit && node scripts/build.js --target=chrome",
    "build:firefox": "node init && tsc --noEmit && node scripts/build.js --target=firefox",
    "build:all": "node init && tsc --noEmit && node scripts/build.js --target=all",
    "generate-icons": "node scripts/generate-icons.js",
    "package": "npm run build && node scripts/package.js --target=chrome",
    "package:firefox": "npm run build:firefox && node scripts/package.js --target=firefox",
    "package:all": "npm run build:all && node scripts/package.js --target=all"
  },
  "keywords": [
    "microsoft-edge",
    "microsoft-365",
    "outlook",
    "teams",
    "email-drafter",
    "meeting-notes",
    "tab-stash",
    "workspace-switcher",
    "productivity"
  ],
  "author": "Sakhawat",
  "license": "MIT",
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.0.280",
    "@types/node": "^20.12.7",
    "dotenv": "^8.2.0",
    "node-fetch": "^3.3.2",
    "typescript": "^5.4.5",
    "vite": "^5.2.11"
  }
}
